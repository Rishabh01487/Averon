# ─── Averon Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── MONGODB (required for persistent auth + chain state + wallets) ──────────
# Get this from MongoDB Atlas: Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://averon:YOUR_PASSWORD@cluster0.xxx.mongodb.net/?retryWrites=true&w=majority

# ── JWT SECRETS (required — generate with: openssl rand -hex 32) ────────────
# Must be the SAME across all nodes (so tokens work everywhere)
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX

# ── SERVER ──────────────────────────────────────────────────────────────────
PORT=4200
NODE_ENV=production
DATA_DIR=./data

# ── P2P NETWORK (set AFTER deploying all nodes) ────────────────────────────
# Comma-separated list of peer WebSocket URLs (use /p2p path on port 4200)
# Format: wss://peer-host/p2p
# Example: PEERS=wss://averon-veew.onrender.com/p2p,wss://averon-production.up.railway.app/p2p
PEERS=

# ── CONSORTIUM WHITELIST (optional — for permissioned network) ─────────────
# Comma-separated list of trusted node IDs (get from /api/network/status)
# If empty, accepts any signed handshake (open mode)
# Example: TRUSTED_NODES=node_abc123,node_def456,node_ghi789
TRUSTED_NODES=

# ── AI VERIFICATION (optional — for Gemini) ────────────────────────────────
GEMINI_API_KEY=

# ── PAYMENTS (optional — for Razorpay) ─────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── POLYGON ANCHOR (optional — public chain verifiability) ─────────────────
# Anchors Averon's Merkle roots to Polygon so anyone can verify the chain
# hasn't been tampered with. Makes Averon publicly auditable.
#
# Setup:
#   1. Get Alchemy API key: https://alchemy.com (free)
#   2. Create Polygon wallet (MetaMask) + get private key
#   3. Get free MATIC: https://faucet.polygon.technology/
#   4. Deploy anchor contract: node scripts/deploy-anchor-contract.js
#   5. Set POLYGON_ANCHOR_CONTRACT to the deployed address
ALCHEMY_API_KEY=
POLYGON_PRIVATE_KEY=
POLYGON_ANCHOR_CONTRACT=

# ── IPFS / PINATA (optional — decentralized frontend) ─────────────────────
# Uploads the frontend to IPFS so it's censorship-resistant.
# Get keys at: https://app.pinata.cloud/developers/api-keys (free 1GB)
PINATA_API_KEY=
PINATA_SECRET_KEY=
